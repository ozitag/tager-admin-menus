{
  "name": "@tager/admin-menus",
  "version": "1.0.5",
  "license": "MIT",
  "exports": {
    "./css": "./dist/style.css",
    ".": "./dist/index.mjs"
  },
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:js": "vite build",
    "build:package": "yarn build:js && (yarn emit-declarations || echo 'vue-tsc: type errors found, declarations emitted anyway')",
    "emit-declarations": "vue-tsc --project tsconfig.json --emitDeclarationOnly",
    "start": "vite",
    "prepare": "yarn build:package",
    "tager:update": "yarn upgrade --latest --scope @tager"
  },
  "dependencies": {
    "path-to-regexp": "^6.2.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.1.2",
    "@tager/admin-layout": "^1.0.0",
    "@tager/admin-services": "^1.0.0",
    "@tager/admin-ui": "^1.0.1",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.21.0",
    "@typescript-eslint/parser": "^5.21.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^10.0.0",
    "core-js": "^3.22.3",
    "eslint": "^8.14.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-vue": "^8.7.1",
    "pinia": "^2.0.27",
    "sass": "^1.51.0",
    "sass-loader": "^12.6.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vue": "^3.2.31",
    "vue-router": "^4.0.14",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "@tager/admin-services": "^1.0.0",
    "@tager/admin-ui": "^1.0.1",
    "vue": "^3.2.33",
    "vue-router": "^4.0.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
